<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="google-site-verification" content="0ON_SQPt9sF1gjm1CXjH_K09c0fdOlngcKjvTen8r3M">
  <title>{{ title }}</title>
  {% if proyecto %}
    {% set metaDescripcion = proyecto.descripcionHtml | striptags | truncate(160) %}
  {% elif pagina == "cv" %}
    {% set metaDescripcion = "Currículum de Alejandro Antoraz Alonso, artista visual y fotógrafo, profesor de Diseño Gráfico en la Escuela de Arte de Valladolid." %}
  {% elif pagina == "contacto" %}
    {% set metaDescripcion = "Contacto de Alejandro Antoraz Alonso: correo electrónico y redes sociales." %}
  {% else %}
    {% set metaDescripcion = "Portfolio fotográfico de Alejandro Antoraz Alonso: proyectos personales que exploran el paisaje, el paisanaje y la extrañeza de lo cotidiano." %}
  {% endif %}
  <meta name="description" content="{{ metaDescripcion }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ metaDescripcion }}">
  {% if proyecto %}
  <meta property="og:image" content="{{ proyecto.portada }}">
  {% endif %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Alejandro Antoraz Alonso",
    "url": "https://alejandro.antoraz.com",
    "email": "mailto:antoraz@proton.me",
    "jobTitle": "Ilustrador y artista visual",
    "sameAs": [
      "https://www.instagram.com/alejantoraz_foto",
      "https://www.behance.net/alejantoraz",
      "https://www.flickr.com/photos/alejantoraz/"
    ]
  }
  </script>
  {% if proyecto %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ImageGallery",
    "name": "{{ proyecto.titulo or proyecto.nombre }}",
    "description": "{{ proyecto.descripcionHtml | striptags | truncate(160) }}",
    "url": "https://alejandro.antoraz.com/proyectos/{{ proyecto.nombre | slug }}/"
  }
  </script>
  {% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --black: #111111;
      --bg: #f5f5f5;
      --gray: #888888;
      --border: #dcdcdc;
    }
    * { box-sizing: border-box; }
    body {
      font-family: 'IBM Plex Mono', monospace;
      margin: 0;
      background: var(--bg);
      color: var(--black);
      -webkit-font-smoothing: antialiased;
    }
    header {
      padding: 2rem 2rem 1.5rem;
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      background-color: var(--bg);
      background-image: url("https://s3.eu-central-003.backblazeb2.com/antoraz-ilustracion/cabecera-fondo.jpg");
      background-repeat: repeat-x;
      background-position: left center;
      background-size: auto 100%;
      z-index: 10;
    }
    @media (max-width: 600px) {
      header {
        padding: 1.25rem 1.25rem 1rem;
      }
    }
    header h1 {
      font-size: 1.15rem;
      font-weight: 700;
      letter-spacing: 0.03em;
      margin: 0;
      color: #fff;
      text-shadow: 0 1px 4px rgba(0, 0, 0, 0.65);
    }
    header p {
      font-size: 0.85rem;
      color: var(--gray);
      margin: 0.4rem 0 1.2rem;
    }
    nav a {
      font-size: 0.9rem;
      color: #fff;
      font-weight: 700;
      text-decoration: none;
      margin-right: 1.5rem;
      letter-spacing: 0.03em;
      border-bottom: 1px solid transparent;
      padding-bottom: 2px;
      transition: border-color 0.2s ease;
      text-shadow: 0 1px 4px rgba(0, 0, 0, 0.65);
    }
    nav a:hover,
    nav a.activo {
      border-color: #fff;
    }
    main {
      padding: 2rem;
      margin: 0;
    }
    .grid {
      display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 2.5rem;
}

    .tarjeta {
      text-decoration: none;
      color: inherit;
      display: block;
    }
    .tarjeta-img {
      overflow: hidden;
      aspect-ratio: 1 / 1;
      background: #e8e8e8;
    }
    .tarjeta-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .tarjeta:hover .tarjeta-img img {
      transform: scale(1.06);
    }
    .tarjeta h3 {
      font-size: 0.8rem;
      font-weight: 500;
      letter-spacing: 0.03em;
      margin: 0.9rem 0 0;
      display: flex;
      justify-content: space-between;
    }
    .tarjeta h3::after {
      content: "→";
      opacity: 0;
      transition: opacity 0.3s ease, transform 0.3s ease;
      transform: translateX(-4px);
    }
    .tarjeta:hover h3::after {
      opacity: 1;
      transform: translateX(0);
    }
    .volver {
      display: inline-block;
      font-size: 0.8rem;
      margin-bottom: 2rem;
      text-decoration: none;
      color: var(--black);
      border-bottom: 1px solid var(--black);
    }
.cabecera-proyecto {
  max-width: 100%;
    }
    .descripcion-proyecto {
      columns: 3 340px;
      column-gap: 2.5rem;
      margin-bottom: 2rem;
      line-height: 1.7;
      font-size: 0.8rem;
    }
    .descripcion-proyecto p {
      margin-bottom: 1rem;
    }
    .fotos-proyecto {
      columns: 3 340px;
      column-gap: 1.5rem;
    }
    .fotos-proyecto img {
      width: 100%;
      display: block;
      margin-bottom: 1.5rem;
      break-inside: avoid;
    }
    .foto-link {
      display: block;
      cursor: zoom-in;
    }
    .lightbox {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.92);
      z-index: 100;
    }
    .lightbox:target {
      display: block;
    }
    .lightbox-cerrar {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      cursor: zoom-out;
    }
    .lightbox-cerrar img {
      display: block;
      max-width: 92vw;
      max-height: 92vh;
      width: auto;
      height: auto;
      object-fit: contain;
      cursor: zoom-out;
    }
    .lightbox-nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      font-size: 2.5rem;
      line-height: 1;
      color: #fff;
      text-decoration: none;
      padding: 1rem;
      z-index: 101;
      cursor: pointer;
      user-select: none;
    }
    .lightbox-nav:hover {
      opacity: 0.7;
    }
    .lightbox-prev {
      left: 0.5rem;
    }
    .lightbox-next {
      right: 0.5rem;
    }
    .cv {
      font-size: 0.9rem;
      line-height: 1.7;
      max-width: 700px;
    }
    .cv h2 {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-top: 2.5rem;
    }
    footer {
      padding: 2rem;
      text-align: center;
      font-size: 0.75rem;
      color: var(--gray);
      border-top: 1px solid var(--border);
      margin-top: 3rem;
    }
  </style>
</head>
<body>
  <header>
    <h1><a href="/" style="color:inherit; text-decoration:none;">alejandro antoraz alonso</a></h1>
    <nav>
      <a href="/" class="{% if pagina == 'proyectos' %}activo{% endif %}">proyectos</a>
      <a href="/cv/" class="{% if pagina == 'cv' %}activo{% endif %}">cv</a>
      <a href="/contacto/" class="{% if pagina == 'contacto' %}activo{% endif %}">contacto</a>
    </nav>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer>
    © 2026 alejandro antoraz alonso
  </footer>
</body>
</html>
